<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <title>Редактирование товара: <%= product.title %></title>
    <style>
        body { font-family: sans-serif; margin: 0; background-color: #f4f4f9; }
        .container { max-width: 900px; margin: 2rem auto; padding: 2rem; background: #fff; border-radius: 8px; box-shadow: 0 2px 5px rgba(0,0,0,0.1); }
        .form-group { margin-bottom: 1.2rem; }
        label { display: block; margin-bottom: 0.5rem; font-weight: bold; }
        input[type="text"], input[type="number"], textarea { width: 100%; padding: 0.6rem; border: 1px solid #ccc; border-radius: 4px; box-sizing: border-box; }
        textarea { height: 100px; resize: vertical; }
        .section-title { margin-top: 2rem; border-bottom: 2px solid #eee; padding-bottom: 0.5rem; }
        .product-list { list-style: none; padding: 0; }
        .product-item { display: flex; align-items: center; justify-content: space-between; padding: 0.6rem 0; border-bottom: 1px solid #f0f0f0; }
        .btn-save { background-color: #007bff; color: #fff; padding: 0.8rem 1.5rem; border: none; border-radius: 4px; cursor: pointer; font-size: 1rem; margin-top: 1.5rem; }
        .btn-save:hover { background-color: #0056b3; }
    </style>
</head>
<body>

<%# Подключаем шапку с кнопкой "+ Add product" %>
<%- include('partials/header') %>

<main class="container">
    <h1>Редактирование товара</h1>

    <% const actionUrl = '/admin/' + product.id; %>
    <form action="<%= actionUrl %>" method="POST">


        <div class="form-group">
            <label for="title">Название товара:</label>
            <input type="text" id="title" name="title" value="<%= product.title %>" required />
        </div>

        <div class="form-group">
            <label for="description">Описание:</label>
            <textarea id="description" name="description" required><%= product.description %></textarea>
        </div>

        <div class="form-group">
            <label for="price">Стоимость (₽):</label>
            <input type="number" id="price" name="price" step="0.01" value="<%= product.price %>" required />
        </div>

        <h2 class="section-title">Похожие товары</h2>
        <% if (similarProducts && similarProducts.length > 0) { %>
        <ul class="product-list">
            <% similarProducts.forEach(function(item) { %>
            <li class="product-item">
                <span><strong><%= item.title %></strong> — <%= item.price %> ₽</span>
                <label>
                    <input type="checkbox" name="similarToRemove" value="<%= item.id %>" />
                    mark to remove
                </label>
            </li>
            <% }); %>
        </ul>
        <% } else { %>
        <p>У данного товара пока нет похожих товаров.</p>
        <% } %>

        <h2 class="section-title">Добавить в похожие</h2>
        <% if (otherProducts && otherProducts.length > 0) { %>
        <ul class="product-list">
            <% otherProducts.forEach(function(item) { %>
            <li class="product-item">
                <span><strong><%= item.title %></strong> — <%= item.price %> ₽</span>
                <label>
                    <input type="checkbox" name="similarToAdd" value="<%= item.id %>" />
                    mark to add
                </label>
            </li>
            <% }); %>
        </ul>
        <% } else { %>
        <p>Нет доступных товаров для добавления в похожие.</p>
        <% } %>

        <button type="submit" class="btn-save">Save changes</button>
    </form>
</main>

</body>
</html>
